# ============================================================================
# Strix (fork SHVIA) — configuração local. Copie para .env e preencha.
#   cp .env.example .env
# O .env está no .gitignore (segredos nunca vão pro git). Use com ./bin/strix-run.
# ============================================================================

# ── Agentes: primário + secundário (o "religar com o outro agente") ─────────
# PRIMARY = agente do dia a dia. SECONDARY = entra quando o primário esgota a
# janela/budget (manual: `strix-run --resume -2`; automático: `strix-run <alvo> --auto`).
# These three slots are the QUEUE. To run ONE agent without touching them, name it on the
# command line instead: `strix-run --agent chatgpt/gpt-5.6-sol <alvo>`. Its key and budget
# are looked up here by provider (see "Chaves por provedor" below).
STRIX_PRIMARY_LLM=chatgpt/gpt-5.4
STRIX_SECONDARY_LLM=deepseek/deepseek-v4-pro
STRIX_TERTIARY_LLM=moonshot/kimi-k3     # 3º na fila (--auto cai pra cá se 1 e 2 esgotarem)

# ── Chaves por provedor ─────────────────────────────────────────────────────
# ChatGPT por ASSINATURA = OAuth (`strix auth login chatgpt`) → NÃO precisa de key.
# Preencha só os provedores que você for usar em PRIMARY/SECONDARY ou em --agent.
# Convention: the provider prefix of the model picks both variables, upper-cased, so
# `xai/grok-4.7` reads XAI_API_KEY + STRIX_BUDGET_XAI and `together_ai/...` reads
# TOGETHER_AI_API_KEY + STRIX_BUDGET_TOGETHER_AI. No script edit is needed for a new provider.
# Aliases: claude → ANTHROPIC, google → GEMINI, kimi / moonshotai → MOONSHOT.
# A budget variable that is not set falls back to STRIX_BUDGET_DEFAULT. The generic
# LLM_API_KEY is only a fallback for providers the launcher does not know by name (custom
# gateways); openai, anthropic, deepseek, gemini, moonshot and minimax never borrow it.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=      # Kimi / Moonshot (kimi-k3)
MINIMAX_API_KEY=       # MiniMax (minimax/MiniMax-M3). China account: also set MINIMAX_API_BASE=https://api.minimaxi.com/v1

# ── Budget por provedor (USD) — teto de gasto pay-as-you-go (--max-budget) ──
# ChatGPT via assinatura não gasta $ (gasta cota), então não tem budget aqui.
STRIX_BUDGET_OPENAI=10
STRIX_BUDGET_ANTHROPIC=10
STRIX_BUDGET_DEEPSEEK=5
STRIX_BUDGET_GEMINI=5
STRIX_BUDGET_MOONSHOT=5
STRIX_BUDGET_MINIMAX=5
STRIX_BUDGET_DEFAULT=5

# ── Saída / runtime ─────────────────────────────────────────────────────────
STRIX_WORKDIR=~/x                 # runs saem em $STRIX_WORKDIR/strix_runs/<run>/
# STRIX_BIN=strix                 # binário/wrapper do strix (default: strix no PATH)

# ── Modelos frontier sugeridos (copie para PRIMARY/SECONDARY) ───────────────
#   chatgpt/gpt-5.4               assinatura ChatGPT (sem custo $, gasta cota de 5h/semana)
#   chatgpt/gpt-5.6-sol           same subscription route; whether your plan serves it is checked by
#                                 the startup model check, not by this file
#   openai/gpt-5.6-sol            pay-as-you-go (needs OPENAI_API_KEY): ~US$ 4 / 20 per MTok in / out
#   openai/gpt-5.6               pay-as-you-go, topo de linha
#   anthropic/claude-opus-5      anthropic/claude-sonnet-5
#   deepseek/deepseek-v4-pro     deepseek/deepseek-v4-flash   (mais barato, frontier)
#   gemini/gemini-3.1-pro-preview  gemini/gemini-3.6-flash
#   minimax/MiniMax-M3           thinking is MiniMax's API default (adaptive), so no setting is needed
#                                (STRIX_REASONING_EFFORT is ignored by M3); ~US$ 0.30 / 1.20 per MTok in / out
#
# Reasoning depth is one global knob for every agent: STRIX_REASONING_EFFORT (none, minimal,
# low, medium, high, xhigh, max; default high). The LEB benchmark ran GPT-5.6-sol at xhigh;
# set it per run with `STRIX_REASONING_EFFORT=xhigh strix-run --agent ... <alvo>` (that only
# works while this file does not set it itself, because strix-run loads the file last).
