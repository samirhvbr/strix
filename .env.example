# ============================================================================
# Strix (fork SHVIA) — configuração local. Copie para .env e preencha.
#   cp .env.example .env
# O .env está no .gitignore (segredos nunca vão pro git). Use com ./bin/strix-run.
# ============================================================================

# ── Agentes: primário + secundário (o "religar com o outro agente") ─────────
# PRIMARY = agente do dia a dia. SECONDARY = entra quando o primário esgota a
# janela/budget (manual: `strix-run --resume -2`; automático: `strix-run <alvo> --auto`).
STRIX_PRIMARY_LLM=chatgpt/gpt-5.4
STRIX_SECONDARY_LLM=deepseek/deepseek-v4-pro

# ── Chaves por provedor ─────────────────────────────────────────────────────
# ChatGPT por ASSINATURA = OAuth (`strix auth login chatgpt`) → NÃO precisa de key.
# Preencha só os provedores que você for usar em PRIMARY/SECONDARY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ── Budget por provedor (USD) — teto de gasto pay-as-you-go (--max-budget) ──
# ChatGPT via assinatura não gasta $ (gasta cota), então não tem budget aqui.
STRIX_BUDGET_OPENAI=10
STRIX_BUDGET_ANTHROPIC=10
STRIX_BUDGET_DEEPSEEK=5
STRIX_BUDGET_GEMINI=5
STRIX_BUDGET_DEFAULT=5

# ── Saída / runtime ─────────────────────────────────────────────────────────
STRIX_WORKDIR=~/x                 # runs saem em $STRIX_WORKDIR/strix_runs/<run>/
STRIX_AUTO_THRESHOLD=2            # nº de 'usage_limit_reached' p/ o --auto fazer failover
# STRIX_BIN=strix                 # binário/wrapper do strix (default: strix no PATH)

# ── Modelos frontier sugeridos (copie para PRIMARY/SECONDARY) ───────────────
#   chatgpt/gpt-5.4               assinatura ChatGPT (sem custo $, gasta cota de 5h/semana)
#   openai/gpt-5.6               pay-as-you-go, topo de linha
#   anthropic/claude-opus-5      anthropic/claude-sonnet-5
#   deepseek/deepseek-v4-pro     deepseek/deepseek-v4-flash   (mais barato, frontier)
#   gemini/gemini-3.1-pro-preview  gemini/gemini-3.6-flash
