#!/usr/bin/env bash
#
# strix-run — launcher config-driven do fork SHVIA do Strix.
#
# Lê o .env do repo (STRIX_PRIMARY_LLM / STRIX_SECONDARY_LLM / STRIX_TERTIARY_LLM,
# chaves por provedor, STRIX_BUDGET_*, STRIX_WORKDIR) e roda o Strix já com o
# modelo, a chave e o teto de budget certos — sem exportar nada na mão.
#
# Uso:
#   strix-run <alvo> [args-do-strix...]     # novo scan, agente PRIMÁRIO (TUI nativa se houver Go)
#   strix-run --resume [<run>]              # retoma último run (ou <run>) no PRIMÁRIO
#   strix-run --resume -2 [<run>]           # retoma no SECUNDÁRIO (-3 = TERCIÁRIO)
#   strix-run <alvo> --auto                 # roda a FILA (primário→secundário→terciário)
#                                           # com a TUI AO VIVO: ao esgotar janela/budget/pausa
#                                           # de um, mata e REABRE a TUI no próximo; para quando
#                                           # um CONCLUI. Sem terminal (cron/pipe) cai p/ headless.
#   strix-run --agent openai/gpt-5.6 <alvo> # agente ad-hoc (sobrepõe a fila)
#   -n | --headless  força modo headless (sem TUI); em --auto força o modo antigo (scrape)
#   strix-run view [run]                    # dashboard web (acha os runs no WORKDIR)
#   strix-run list                          # lista os runs locais no TERMINAL (sem web/e-mail)
#   strix-run pdf <run> [saida.pdf]         # gera o PDF do relatório LOCAL (sem e-mail/relay)
#
# Flags extras (ex.: -m quick, --instruction "...", --max-turns N) são
# repassadas ao strix. Runs saem em  $STRIX_WORKDIR/strix_runs/<run>/ .
#
set -euo pipefail

# ── localizar repo e carregar .env ───────────────────────────────────────────
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="${STRIX_ENV_FILE:-$REPO_DIR/.env}"
if [[ -f "$ENV_FILE" ]]; then
  set -a; # shellcheck disable=SC1090
  source "$ENV_FILE"; set +a
fi

# ── defaults (podem vir do .env) ─────────────────────────────────────────────
PRIMARY="${STRIX_PRIMARY_LLM:-chatgpt/gpt-5.4}"
SECONDARY="${STRIX_SECONDARY_LLM:-deepseek/deepseek-v4-pro}"
TERTIARY="${STRIX_TERTIARY_LLM:-}"
WORKDIR="${STRIX_WORKDIR:-$HOME/x}"                 # runs -> $WORKDIR/strix_runs/
STRIX_BIN="${STRIX_BIN:-strix}"
HEADLESS=0            # -n/--headless força; senão modos manuais abrem a TUI nativa (se houver Go)

# Atalho: `strix-run view [run] [flags]` = `strix view` rodando no WORKDIR,
# onde ficam os runs (senão o `strix view` procura em ./strix_runs do cwd atual).
if [[ "${1:-}" == "pdf" ]]; then
  shift
  run="${1:-}"; [[ -n "$run" ]] || die "uso: strix-run pdf <run> [saida.pdf]  (veja: strix-run list)"
  rundir="$WORKDIR/strix_runs/$run"
  [[ -f "$rundir/run.json" ]] || die "run não encontrado: $rundir"
  out="${2:-$rundir/strix-report-$run.pdf}"
  exec uv run --project "$REPO_DIR" python - "$rundir" "$out" <<'PYEOF'
import sys
from pathlib import Path
from strix.interface.viewer.report_pdf import generate_report_pdf
rundir, out = Path(sys.argv[1]), Path(sys.argv[2])
out.write_bytes(generate_report_pdf(rundir))
print(f"[strix-run] PDF local gerado (sem e-mail/relay): {out} ({out.stat().st_size // 1024} KB)")
PYEOF
fi

if [[ "${1:-}" == "list" || "${1:-}" == "runs" ]]; then
  exec python3 - "$WORKDIR/strix_runs" <<'PYEOF'
import json, os, sys, glob
from collections import Counter
base = sys.argv[1]
dirs = sorted(glob.glob(base + "/*/"), key=os.path.getmtime, reverse=True)
if not dirs:
    print("(nenhum run em %s)" % base); sys.exit(0)
print("%-34s %-10s %-6s %-13s %8s %9s" % ("RUN", "STATUS", "VULNS", "SEV", "CUSTO", "TOKENS"))
for d in dirs:
    name = os.path.basename(d.rstrip("/"))
    try: rj = json.load(open(d + "run.json"))
    except Exception: rj = {}
    st = rj.get("status", "?"); u = rj.get("llm_usage", {}) or {}
    cost = u.get("cost") or 0; intok = u.get("input_tokens") or 0
    try:
        vj = json.load(open(d + "vulnerabilities.json"))
        vs = vj.get("vulnerabilities", vj) if isinstance(vj, dict) else vj
    except Exception: vs = []
    sev = Counter((v.get("severity") or "?").upper() for v in vs)
    sevs = " ".join("%s%d" % (k[0], sev[k]) for k in ("CRITICAL","HIGH","MEDIUM","LOW","INFO") if sev.get(k)) or "-"
    print("%-34s %-10s %-6d %-13s %7.2f %8dk" % (name[:34], st, len(vs), sevs, cost, intok // 1000))
print("\nabrir um: strix-run view <RUN>")
PYEOF
fi

if [[ "${1:-}" == "view" ]]; then
  shift
  cd "$WORKDIR" && exec "${STRIX_BIN}" view "$@"
fi

c_info=$'\033[36m'; c_warn=$'\033[33m'; c_err=$'\033[31m'; c_off=$'\033[0m'
log()  { printf '%s[strix-run]%s %s\n' "$c_info" "$c_off" "$*" >&2; }
warn() { printf '%s[strix-run] %s%s\n' "$c_warn" "$*" "$c_off" >&2; }
die()  { printf '%s[strix-run] %s%s\n' "$c_err" "$*" "$c_off" >&2; exit 1; }

usage() { sed -n '3,26p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

provider_of() { printf '%s' "${1%%/*}"; }

# ── resolve chave + budget de um modelo (globais KEY / BUDGET) ────────────────
KEY=""; BUDGET=""
resolve_creds() {
  local prov; prov="$(provider_of "$1")"
  case "$prov" in
    chatgpt|codex)     KEY="";                        BUDGET="" ;;   # assinatura (OAuth)
    openai)            KEY="${OPENAI_API_KEY:-}";      BUDGET="${STRIX_BUDGET_OPENAI:-}" ;;
    anthropic|claude)  KEY="${ANTHROPIC_API_KEY:-}";   BUDGET="${STRIX_BUDGET_ANTHROPIC:-}" ;;
    deepseek)          KEY="${DEEPSEEK_API_KEY:-}";    BUDGET="${STRIX_BUDGET_DEEPSEEK:-}" ;;
    gemini|google)     KEY="${GEMINI_API_KEY:-}";      BUDGET="${STRIX_BUDGET_GEMINI:-}" ;;
    moonshot|moonshotai|kimi) KEY="${MOONSHOT_API_KEY:-}"; BUDGET="${STRIX_BUDGET_MOONSHOT:-}" ;;
    *)                 KEY="${LLM_API_KEY:-}";         BUDGET="${STRIX_BUDGET_DEFAULT:-}" ;;
  esac
}

# aplica STRIX_LLM/LLM_API_KEY do modelo e devolve os args de budget em BUDGET_ARGS[]
BUDGET_ARGS=()
apply_model() {
  local model="$1"; resolve_creds "$model"
  export STRIX_LLM="$model"
  if [[ -n "$KEY" ]]; then export LLM_API_KEY="$KEY"; else unset LLM_API_KEY 2>/dev/null || true; fi
  BUDGET_ARGS=(); [[ -n "$BUDGET" ]] && BUDGET_ARGS=(--max-budget "$BUDGET")
  local prov; prov="$(provider_of "$model")"
  if [[ "$prov" != "chatgpt" && "$prov" != "codex" && -z "$KEY" ]]; then
    warn "sem chave para o provedor '$prov' no .env — o strix pode falhar na conexão"
  fi
  if [[ "$prov" != "chatgpt" && "$prov" != "codex" && -z "$BUDGET" ]]; then
    warn "sem budget (defina STRIX_BUDGET_${prov^^} no .env) para '$prov' — rodará SEM teto de custo"
  fi
  log "agente=$model  budget=${BUDGET:-—}  workdir=$WORKDIR"
}

# NFLAG[] = (-n) quando headless; vazio = TUI nativa. TUI exige Go (go run).
compute_nflag() {
  NFLAG=(); tela="TUI nativa"
  if (( HEADLESS )) || ! command -v go >/dev/null 2>&1; then NFLAG=(-n); tela="headless"; fi
}

latest_run() {
  # newest run dir that actually looks like a run (has run.json) — ignora dirs vazios/lixo
  local d
  while IFS= read -r d; do
    [[ -f "${d}run.json" ]] && { printf '%s' "$d"; return 0; }
  done < <(ls -1dt "$WORKDIR"/strix_runs/*/ 2>/dev/null || true)
  return 0
}

# ── parse de argumentos ──────────────────────────────────────────────────────
MODE="new"; AGENT="primary"; RUN=""; TARGET=""; EXTRA=()
while (($#)); do
  case "$1" in
    --resume)         MODE="resume"; shift
                      if [[ -n "${1:-}" && "${1:0:1}" != "-" ]]; then RUN="$1"; shift; fi ;;
    --auto)           MODE="auto"; shift ;;
    -n|--headless)    HEADLESS=1; shift ;;
    -2|--secondary)   AGENT="secondary"; shift ;;
    -1|--primary)     AGENT="primary"; shift ;;
    -3|--tertiary)    AGENT="tertiary"; shift ;;
    --agent)          AGENT="${2:?--agent exige um modelo}"; shift 2 ;;
    -t|--target)      TARGET="${2:?-t/--target exige uma URL/alvo}"; shift 2 ;;
    -h|--help)        usage; exit 0 ;;
    --)               shift; EXTRA+=("$@"); break ;;
    -*)               EXTRA+=("$1"); shift ;;          # pass-through p/ o strix
    *)                if [[ -z "$TARGET" ]]; then TARGET="$1"; else EXTRA+=("$1"); fi; shift ;;
  esac
done

# Em --resume, um argumento posicional é o RUN, não um alvo. Sem isto,
# `strix-run --resume -2 <run>` jogava o <run> em TARGET (porque vem depois de
# uma flag) e o script retomava o ÚLTIMO run. Agora as duas ordens funcionam:
#   strix-run -2 --resume <run>   e   strix-run --resume -2 <run>
if [[ "$MODE" == "resume" && -z "$RUN" && -n "$TARGET" ]]; then
  RUN="$TARGET"; TARGET=""
fi

# modelo do agente escolhido
case "$AGENT" in
  primary)   MODEL="$PRIMARY" ;;
  secondary) MODEL="$SECONDARY" ;;
  tertiary)  MODEL="${TERTIARY:?STRIX_TERTIARY_LLM não definido no .env}" ;;
  */*)       MODEL="$AGENT" ;;
  *)         die "agente inválido: $AGENT (use --primary, --secondary ou --agent prov/modelo)" ;;
esac

command -v "$STRIX_BIN" >/dev/null 2>&1 || die "'$STRIX_BIN' não encontrado no PATH"
mkdir -p "$WORKDIR/strix_runs"

# ── execução ─────────────────────────────────────────────────────────────────
case "$MODE" in
  new)
    [[ -n "$TARGET" ]] || die "faltou o alvo. Ex.: strix-run https://exemplo.com"
    apply_model "$MODEL"
    compute_nflag
    log "novo scan  alvo=$TARGET  ($tela)"
    ( cd "$WORKDIR" && exec "$STRIX_BIN" "${NFLAG[@]}" --target "$TARGET" "${EXTRA[@]}" "${BUDGET_ARGS[@]}" )
    ;;

  resume)
    if [[ -z "$RUN" ]]; then
      d="$(latest_run)"; [[ -n "$d" ]] || die "nenhum run em $WORKDIR/strix_runs/ para retomar"
      RUN="$(basename "$d")"; log "último run: $RUN"
    fi
    apply_model "$MODEL"
    compute_nflag
    log "retomando run=$RUN  ($tela)"
    ( cd "$WORKDIR" && exec "$STRIX_BIN" "${NFLAG[@]}" --resume "$RUN" "${EXTRA[@]}" "${BUDGET_ARGS[@]}" )
    ;;

  auto)
    [[ -n "$TARGET" ]] || die "faltou o alvo. Ex.: strix-run https://exemplo.com --auto"
    cd "$WORKDIR"

    # fila de agentes (ordem: primário, secundário, terciário); ignora vazios
    QUEUE=()
    [[ -n "$PRIMARY"   ]] && QUEUE+=("$PRIMARY")
    [[ -n "$SECONDARY" ]] && QUEUE+=("$SECONDARY")
    [[ -n "$TERTIARY"  ]] && QUEUE+=("$TERTIARY")
    (( ${#QUEUE[@]} )) || die "fila vazia (defina STRIX_PRIMARY_LLM no .env)"
    N=${#QUEUE[@]}
    log "AUTO: fila (${N}) = ${QUEUE[*]}"

    before="$(ls -1d strix_runs/*/ 2>/dev/null | sort || true)"
    find_new_run() {
      local cur; cur="$(ls -1d strix_runs/*/ 2>/dev/null | sort || true)"
      comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$cur") | sed '/^$/d' | tail -1 || true
    }

    # Marcadores de esgotamento (janela do provedor OU budget em dólar). No modo
    # TUI (interativo) o budget PAUSA em vez de encerrar (BudgetPausedError →
    # status budget_paused), então incluímos as mensagens de pausa; no headless
    # encerra com "Token budget ... exceeded".
    _RUNOUT='usage_limit_reached|usage limit has been reached|Token budget of|Scan budget of|pausing until the user continues|budget_paused'
    grep_runout() {   # $1=arquivo  $2=offset(bytes) — 0 se achou marcador no trecho novo
      local f="$1" o="${2:-0}"
      [[ -n "$f" && -f "$f" ]] || return 1
      tail -c "+$(( o + 1 ))" "$f" 2>/dev/null | grep -qE "$_RUNOUT"
    }
    run_status() {    # imprime run.json.status (vazio se não há); sempre sai 0
      [[ -n "${RUNDIR:-}" && -f "${RUNDIR%/}/run.json" ]] || return 0
      python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("status",""))' "${RUNDIR%/}/run.json" 2>/dev/null || true
    }
    kill_tree() {     # $1=pid  $2=sinal(TERM) — mata pid e descendentes (filhos primeiro)
      local pid="$1" sig="${2:-TERM}" c
      for c in $(pgrep -P "$pid" 2>/dev/null || true); do kill_tree "$c" "$sig"; done
      kill "-$sig" "$pid" 2>/dev/null || true
    }
    reset_term() {    # devolve o terminal ao normal depois de matar uma TUI full-screen
      [[ -t 1 ]] || return 0
      stty sane 2>/dev/null || true
      printf '\033[?1049l\033[?25h\033[0m' > /dev/tty 2>/dev/null || true
    }

    # #1 auto-continue: instrução injetada no root agent na retomada. O Strix só
    # injeta a --instruction quando is_resume (runner.py send→root, priority high),
    # então a fila segue sozinha sem você digitar "continue" na TUI. Vale p/ TUI e
    # headless. O usuário pode sobrepor passando o próprio --instruction (fica por
    # último e o argparse usa esse).
    RESUME_MSG="Continue the penetration test from where it stopped. The previous agent's LLM quota or budget was exhausted and control passed to you. Review the current run state (notes, coverage, findings, todos) and keep going autonomously — do not wait for further user input."

    run_cost() {   # $1=run dir → imprime llm_usage.cost (0 se n/a); sempre sai 0
      [[ -n "$1" && -f "${1%/}/run.json" ]] || { echo 0; return 0; }
      python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("llm_usage",{}).get("cost") or 0)' "${1%/}/run.json" 2>/dev/null || echo 0
    }

    # #3 budget por-provedor: na retomada da fila cada provedor ganha o SEU teto
    # inteiro por cima do já gasto. O hook do Strix compara o custo CUMULATIVO do
    # run com --max-budget, então sem isso o 2º+ provedor em dólar já entra
    # estourado e pausa na cara. STRIX_BUDGET_MODE=global mantém o teto cumulativo
    # antigo (um teto global do scan).
    apply_resume_budget() {   # $1=run dir — recomputa BUDGET_ARGS para o resume
      [[ -n "$BUDGET" ]] || { BUDGET_ARGS=(); return 0; }        # provedor sem teto (ex.: chatgpt)
      if [[ "${STRIX_BUDGET_MODE:-per-provider}" == "global" ]]; then
        BUDGET_ARGS=(--max-budget "$BUDGET"); return 0
      fi
      local spent eff
      spent="$(run_cost "$1")"
      eff="$(python3 -c 'import sys;print(round(float(sys.argv[1])+float(sys.argv[2]),4))' "${spent:-0}" "$BUDGET" 2>/dev/null || echo "$BUDGET")"
      BUDGET_ARGS=(--max-budget "$eff")
      log "  budget: \$$BUDGET próprio do $model (teto efetivo \$$eff sobre \$${spent:-0} já gastos)"
    }

    STRIX_PID=""; WATCH_PID=""
    _cleanup_auto() {
      [[ -n "$WATCH_PID" ]] && kill "$WATCH_PID" 2>/dev/null || true
      [[ -n "$STRIX_PID" ]] && kill_tree "$STRIX_PID" TERM 2>/dev/null || true
      reset_term
    }

    # ── caminho A: TUI ao vivo + failover (quando há terminal) ─────────────────
    # Roda o Strix interativo em background: sem job control (set +m) ele fica no
    # MESMO process group do terminal, e com stdin em /dev/tty a TUI lê o teclado
    # e desenha normal. O watcher vigia strix.log/run.json do run; ao esgotar
    # (janela/budget/pausa), sinaliza, mata a árvore do Strix e a fila avança
    # REABRINDO a TUI no próximo agente (resume no mesmo run).
    auto_tui() {
      set +m
      local idx model off flag PERR st exhausted
      local RUNDIR="" LOG=""
      for idx in "${!QUEUE[@]}"; do
        model="${QUEUE[$idx]}"
        apply_model "$model"
        PERR="$(mktemp "${TMPDIR:-/tmp}/strix-run.err.XXXXXX")"
        flag="$(mktemp -u "${TMPDIR:-/tmp}/strix-run.flag.XXXXXX")"

        if [[ -n "$RUNDIR" ]]; then
          apply_resume_budget "$RUNDIR"
          off="$(stat -c%s "${RUNDIR%/}/strix.log" 2>/dev/null || echo 0)"
          log "agente $((idx+1))/$N ($model) → REABRE a TUI (resume $(basename "$RUNDIR"))"
          "$STRIX_BIN" --resume "$(basename "$RUNDIR")" --instruction "$RESUME_MSG" "${EXTRA[@]}" "${BUDGET_ARGS[@]}" < /dev/tty 2>"$PERR" &
        else
          off=0
          log "agente $((idx+1))/$N ($model) → SCAN NOVO $TARGET (TUI)"
          "$STRIX_BIN" --target "$TARGET" "${EXTRA[@]}" "${BUDGET_ARGS[@]}" < /dev/tty 2>"$PERR" &
        fi
        STRIX_PID=$!

        # watcher: acha o run dir sozinho e vigia até esgotar ou o processo sair.
        ( set +e
          wrd="$RUNDIR"; wlog="$LOG"
          while kill -0 "$STRIX_PID" 2>/dev/null; do
            if [[ -z "$wrd" ]]; then
              wrd="$(find_new_run)"
              [[ -n "$wrd" ]] && wlog="${wrd%/}/strix.log"
            fi
            wst=""
            [[ -n "$wrd" && -f "${wrd%/}/run.json" ]] && \
              wst="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("status",""))' "${wrd%/}/run.json" 2>/dev/null || true)"
            [[ "$wst" == "completed" ]] && break
            if grep_runout "$wlog" "$off" || grep_runout "$PERR" 0; then
              : > "$flag"
              kill_tree "$STRIX_PID" TERM; sleep 2; kill_tree "$STRIX_PID" KILL
              break
            fi
            sleep 3
          done
        ) &
        WATCH_PID=$!

        wait "$STRIX_PID" 2>/dev/null || true
        kill "$WATCH_PID" 2>/dev/null || true
        wait "$WATCH_PID" 2>/dev/null || true
        STRIX_PID=""; WATCH_PID=""
        [[ -f "$flag" ]] && reset_term

        [[ -z "$RUNDIR" ]] && RUNDIR="$(find_new_run)"
        [[ -n "$RUNDIR" ]] && LOG="${RUNDIR%/}/strix.log"
        st="$(run_status)"

        if [[ "$st" == "completed" ]]; then
          rm -f "$PERR"
          log "✔ agente $model CONCLUIU o scan (run $(basename "$RUNDIR")). Fim."
          return 0
        fi

        exhausted=0
        if [[ -f "$flag" ]] || grep_runout "$LOG" "$off" || grep_runout "$PERR" 0; then
          exhausted=1
        elif [[ -z "$RUNDIR" ]]; then
          # nem criou run: falha de preflight/conexão (ex.: 429 usage limit)
          exhausted=1
          [[ -s "$PERR" ]] && { warn "preflight de $model falhou (nem criou run):"; tail -n 15 "$PERR" >&2; }
        fi

        if (( exhausted )); then
          rm -f "$PERR"
          if (( idx + 1 >= N )); then
            die "todos os $N agentes esgotaram/falharam janela/budget. Tente mais tarde ou ajuste o .env."
          fi
          warn "agente $model esgotou (janela/budget) — trocando de agente"
          log "→ próximo agente na fila"
          continue
        fi

        # nem concluiu nem esgotou: você saiu da TUI (q/Ctrl-C) ou erro real
        warn "agente $model encerrou sem concluir e sem sinal de cota (saiu da TUI? erro?). Parando a cadeia."
        [[ -s "$PERR" ]] && tail -n 15 "$PERR" >&2
        rm -f "$PERR"
        return 1
      done
      return 1
    }

    # ── caminho B: headless + scrape de stdout (sem terminal: cron/pipe/ssh -T) ─
    auto_headless() {
      local idx model POUT off PID RUNOUT st
      local RUNDIR="" LOG=""
      for idx in "${!QUEUE[@]}"; do
        model="${QUEUE[$idx]}"
        apply_model "$model"
        LOG=""; off=0
        [[ -n "$RUNDIR" ]] && { LOG="${RUNDIR%/}/strix.log"; off="$(stat -c%s "$LOG" 2>/dev/null || echo 0)"; }
        POUT="$(mktemp "${TMPDIR:-/tmp}/strix-run.XXXXXX")"
        if [[ -n "$RUNDIR" ]]; then
          apply_resume_budget "$RUNDIR"
          log "agente $((idx+1))/$N ($model) → RESUME $(basename "$RUNDIR")"
          "$STRIX_BIN" -n --resume "$(basename "$RUNDIR")" --instruction "$RESUME_MSG" "${EXTRA[@]}" "${BUDGET_ARGS[@]}" > >(tee "$POUT") 2>&1 &
        else
          log "agente $((idx+1))/$N ($model) → SCAN NOVO $TARGET"
          "$STRIX_BIN" -n --target "$TARGET" "${EXTRA[@]}" "${BUDGET_ARGS[@]}" > >(tee "$POUT") 2>&1 &
        fi
        PID=$!
        RUNOUT=0
        while kill -0 "$PID" 2>/dev/null; do
          if [[ -z "$RUNDIR" ]]; then
            RUNDIR="$(find_new_run)"; [[ -n "$RUNDIR" ]] && LOG="${RUNDIR%/}/strix.log"
          fi
          if grep_runout "$POUT" 0 || grep_runout "$LOG" "$off"; then
            warn "agente $model esgotou (janela/budget)"
            RUNOUT=1; kill_tree "$PID" TERM; break
          fi
          sleep 3
        done
        wait "$PID" 2>/dev/null || true
        [[ -z "$RUNDIR" ]] && { RUNDIR="$(find_new_run)"; [[ -n "$RUNDIR" ]] && LOG="${RUNDIR%/}/strix.log"; }
        if (( RUNOUT == 0 )); then
          if grep_runout "$POUT" 0 || grep_runout "$LOG" "$off"; then RUNOUT=1; fi
        fi
        rm -f "$POUT"
        st="$(run_status)"
        if [[ "$st" == "completed" ]]; then
          log "✔ agente $model CONCLUIU o scan (run $(basename "$RUNDIR")). Fim."
          return 0
        fi
        if (( RUNOUT == 1 )); then
          if (( idx + 1 >= N )); then
            die "todos os $N agentes esgotaram janela/budget. Tente mais tarde ou ajuste o .env."
          fi
          log "→ próximo agente na fila"
          continue
        fi
        warn "agente $model parou sem concluir e sem sinal de cota (erro?). Parando a cadeia; veja a saída acima."
        return 1
      done
      return 1
    }

    trap _cleanup_auto EXIT INT TERM
    if [[ -t 0 && -t 1 ]] && (( ! HEADLESS )); then
      if auto_tui; then ec=0; else ec=1; fi
    else
      if (( HEADLESS )); then warn "modo headless forçado (-n): sem painel TUI"
      else warn "sem terminal interativo: usando modo headless (sem painel TUI)"; fi
      if auto_headless; then ec=0; else ec=1; fi
    fi
    exit "$ec"
    ;;

  *) die "modo desconhecido: $MODE" ;;
esac
